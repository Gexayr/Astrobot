# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=astrobot
POSTGRES_USER=astrobot
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Host port the app listens on (localhost only; nginx proxies to it)
APP_PORT=3000
LOG_LEVEL=info

# Optional: Telegram notifications for new pre-orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only for running without Docker (PM2 / local dev):
# DATABASE_URL=postgres://astrobot:password@localhost:5432/astrobot
